          "download_url": "https://pdf.s3.us-southeast-1.idrivee2.com/novels/the_scoundrel_immortals_coup/481_The%20Scoundrel%20Immortal%E2%80%99s%20Coup%20-%20Vol%2001.pdf?X-Amz-Algorithm=AWS4-HMAC-SHA256&X-Amz-Credential=L01XesFy3RgmqaeVQsOY%2F20261106%2Fus-southeast-1%2Fs3%2Faws4_request&X-Amz-Date=20261106T102127Z&X-Amz-Expires=604800&X-Amz-SignedHeaders=host&X-Amz-Signature=8c7cabf1a673c8981b70626dae801c6aa45f5f07de1281b35bccf36122325949",
          "filename": "The Scoundrel Immortal’s Coup - Vol 01.pdf",
          "first": 1,
          "is_novel_volume": true,
          "last": 1,
          "message_id": 481,
